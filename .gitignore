# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
*.tsbuildinfo

# Env / secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Drizzle generated migrations are tracked; local artifacts are not
drizzle/meta/_journal.tmp

# Editor / OS
.DS_Store
.idea/
*.swp

# File-sync duplicate artifacts (e.g. "foo 2.ts") from cloud-sync/backup tools
*\ [0-9].*
*\ [0-9][0-9].*

# Terraform
*.tfstate
*.tfstate.*
.terraform/
terraform.tfvars

# Local stack runtime artifacts (scripts/run-local-stack.sh)
.local/
