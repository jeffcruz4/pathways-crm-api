# Pathways CRM API — example environment. Copy to .env for local dev.
# Config-first: all runtime config comes from the environment.

NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# Data backend: "memory" (seeded sample data, default) or "postgres".
DATA_BACKEND=memory

# When DATA_BACKEND=postgres, set EITHER the discrete DB_* parts (preferred) or
# DATABASE_URL. Prefer DB_* for RDS — an RDS-managed password with URL-special
# characters (?, :, @, ], $) then needs no percent-encoding.
#
# Discrete parts (local Docker Postgres from docker-compose.dev.yml):
#   DB_HOST=localhost
#   DB_PORT=5433
#   DB_NAME=pathways
#   DB_USER=pathways
#   DB_PASSWORD=pathways
#   DB_SSLMODE=disable        # use "require" for RDS
#
# Or a single URL (local example):
#   DATABASE_URL=postgres://pathways:pathways@localhost:5433/pathways
# RDS URL (TLS required; password must be percent-encoded):
#   DATABASE_URL=postgres://pathways:<url-encoded-pw>@<endpoint>:5432/pathways?sslmode=require

# Comma-separated allowed CORS origins (the browser UI).
CORS_ORIGINS=http://localhost:5173

# ── Twilio SMS integration ──
# The Auth Token is a secret and is read from the environment (or Secrets
# Manager later) — it is never stored in the database or returned by the API.
# Account SID, Messaging Service SID / from-number, and business details are
# configured from Admin → Integrations and stored (safely) in the DB.
#
# TWILIO_AUTH_TOKEN is referenced by name from the stored connection
# (credential_ref). The default ref is "env:TWILIO_AUTH_TOKEN".
#   TWILIO_AUTH_TOKEN=your-twilio-auth-token
#
# Public base URL the Twilio webhooks are configured to call, used only to show
# setup instructions in the admin UI (e.g. https://api.example.com).
#   PUBLIC_BASE_URL=http://localhost:8080
#
# Set to "true" to skip Twilio webhook signature validation in local dev ONLY.
# Never enable in production.
#   TWILIO_SKIP_SIGNATURE_VALIDATION=false
