# Pathways CRM API — example environment. Copy to .env for local dev.
# Config-first: all runtime config comes from the environment.

NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# Data backend: "memory" (seeded sample data, default) or "postgres" (RDS).
DATA_BACKEND=memory
# Required only when DATA_BACKEND=postgres:
# DATABASE_URL=postgres://user:pass@host:5432/pathways

# Comma-separated allowed CORS origins (the browser UI).
CORS_ORIGINS=http://localhost:5173
